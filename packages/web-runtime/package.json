{
  "name": "@tsuuanmi/pi-web-runtime",
  "version": "0.1.0",
  "description": "Host-neutral browser runtime and web provider descriptors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "npm run clean && tsgo -p tsconfig.build.json",
    "test": "vitest --run"
  },
  "pi": {
    "webProviders": [
      "dist/providers/chatgpt/index.js"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "playwright": "1.62.0",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@types/turndown": "5.0.5",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuuanmi/pi.git",
    "directory": "packages/web-runtime"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
