{
	"name": "@tsuuanmi/pi",
	"version": "0.2.3",
	"description": "Coding agent CLI with read, bash, edit, write, lsp tools and session management",
	"type": "module",
	"os": [
		"darwin",
		"linux"
	],
	"piConfig": {
		"configDir": ".pi"
	},
	"bin": {
		"pi": "dist/cli/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./extensions": {
			"types": "./dist/loader/extensions/index.d.ts",
			"import": "./dist/loader/extensions/index.js"
		},
		"./loader": {
			"types": "./dist/loader/index.d.ts",
			"import": "./dist/loader/index.js"
		},
		"./loader/config": {
			"types": "./dist/loader/config.d.ts",
			"import": "./dist/loader/config.js"
		},
		"./session/root": {
			"types": "./dist/session/root.d.ts",
			"import": "./dist/session/root.js"
		},
		"./tmux": {
			"types": "./dist/cli/tmux.d.ts",
			"import": "./dist/cli/tmux.js"
		}
	},
	"imports": {
		"#pi/*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		},
		"#pi-test/*": {
			"types": "./test/*.ts",
			"import": "./test/*.ts"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"npm-shrinkwrap.json"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build:ts": "npm run clean && tsgo -p tsconfig.build.json && shx chmod +x dist/cli/cli.js",
		"build": "npm run build:ts && npm run copy-assets",
		"copy-assets": "node scripts/copy-assets.mjs",
		"test": "vitest --run",
		"shrinkwrap": "node scripts/generate-shrinkwrap.mjs",
		"prepublishOnly": "npm run build && npm run shrinkwrap"
	},
	"dependencies": {
		"@tsuuanmi/pi-agent": "^0.2.3",
		"@tsuuanmi/pi-ai": "^0.2.3",
		"@tsuuanmi/pi-tui": "^0.2.3",
		"chalk": "5.6.2",
		"diff": "8.0.4",
		"glob": "13.0.6",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.5",
		"jiti": "2.7.0",
		"minimatch": "10.2.5",
		"proper-lockfile": "4.1.2",
		"pyright": "1.1.410",
		"semver": "7.8.0",
		"typescript": "5.9.3",
		"typescript-language-server": "5.3.0",
		"typebox": "1.1.38",
		"undici": "8.5.0",
		"yaml": "2.9.0"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	},
	"devDependencies": {
		"@types/hosted-git-info": "3.0.5",
		"@types/node": "24.12.4",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"shx": "0.4.0",
		"vitest": "3.2.6"
	},
	"keywords": [
		"pi",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Superman",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsuuanmi/pi.git",
		"directory": "packages/pi"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
