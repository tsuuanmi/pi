{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "./dist",
		"paths": {
			"#pi/*": ["./src/*"],
			"@tsuuanmi/pi/extensions": ["./src/loader/extensions/index.ts"],
			"@tsuuanmi/pi/loader/config": ["./src/loader/config.ts"],
			"@tsuuanmi/pi-agent": ["../agent/dist/index.d.ts"],
			"@tsuuanmi/pi-agent/node": ["../agent/dist/node/node.d.ts"],
			"@tsuuanmi/pi-agent/*": ["../agent/dist/*.d.ts"],
			"@tsuuanmi/pi-ai": ["../ai/dist/index.d.ts"],
			"@tsuuanmi/pi-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@tsuuanmi/pi-tui": ["../tui/dist/index.d.ts"],
			"@tsuuanmi/pi-tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist"]
}
