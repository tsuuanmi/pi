{
	"name": "@tsuuanmi/pi-orchestrator",
	"version": "0.2.3",
	"description": "Task, team, and multi-agent orchestration primitives for Pi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#orchestrator/*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "npm run clean && tsgo -p tsconfig.build.json && npm run copy-assets",
		"copy-assets": "node scripts/copy-assets.mjs",
		"test": "vitest --run",
		"prepublishOnly": "npm run build"
	},
	"pi": {
		"commands": [
			"dist/subagents/subagent-worker.js"
		]
	},
	"dependencies": {
		"@tsuuanmi/pi": "0.2.3",
		"@tsuuanmi/pi-agent": "^0.2.3",
		"@tsuuanmi/pi-ai": "^0.2.3",
		"typebox": "1.1.38"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"orchestration",
		"multi-agent"
	],
	"author": "Superman",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsuuanmi/pi.git",
		"directory": "packages/orchestrator"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@tsuuanmi/pi-ai": "^0.2.3",
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "3.2.6"
	}
}
