{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tsuuanmi/pi/packages/workflows/state.schema.json",
  "title": "Pi Workflow State Commands",
  "description": "Strict CLI contract for read-only workflow state inspection and explicit clearing. Session identity is supplied only through --session.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 0,
  "$defs": {
    "emptyInput": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  },
  "x-pi-cli": {
    "sessionFlag": "--session",
    "sessionRequired": true,
    "jsonInput": false,
    "actions": ["read", "clear", "active", "doctor"]
  },
  "x-pi-docs": {
    "commands": "docs/state/commands.md",
    "state": "docs/state/state.md"
  },
  "x-pi-actions": {
    "read": { "$ref": "#/$defs/emptyInput" },
    "clear": { "$ref": "#/$defs/emptyInput" },
    "active": { "$ref": "#/$defs/emptyInput" },
    "doctor": { "$ref": "#/$defs/emptyInput" }
  },
  "examples": [
    "pi workflow state ralplan read --session 20260809-144450 --json",
    "pi workflow state team clear --session 20260809-144450 --json",
    "pi workflow state active --session 20260809-144450 --json",
    "pi workflow state ultragoal doctor --session 20260809-144450 --json"
  ]
}
