{
	"name": "@tsuuanmi/pi-workflows",
	"version": "0.2.3",
	"description": "Workflow runtime skills for Pi: deep-interview, ralplan, team, and ultragoal",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./commands/workflow": {
			"types": "./dist/commands/workflow.d.ts",
			"import": "./dist/commands/workflow.js"
		},
		"./tool": {
			"types": "./dist/tool/index.d.ts",
			"import": "./dist/tool/index.js"
		},
		"./hooks": {
			"types": "./dist/hooks.d.ts",
			"import": "./dist/hooks.js"
		},
		"./extension": {
			"types": "./dist/extension.d.ts",
			"import": "./dist/extension.js"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#workflows/*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		},
		"#workflows-test/*": {
			"types": "./test/*.ts",
			"import": "./test/*.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "npm run clean && tsgo -p tsconfig.build.json && npm run copy-assets",
		"copy-assets": "node scripts/copy-assets.mjs",
		"test": "vitest --run"
	},
	"pi": {
		"extensions": [
			"dist/extension.js"
		],
		"skills": [
			"dist/skills/**/SKILL.md"
		],
		"agents": [
			"dist/agents/*.md"
		],
		"commands": [
			"dist/commands/workflow.js"
		]
	},
	"dependencies": {
		"@tsuuanmi/pi": "^0.2.3",
		"@tsuuanmi/pi-agent": "^0.2.3",
		"@tsuuanmi/pi-ai": "^0.2.3",
		"@tsuuanmi/pi-orchestrator": "^0.2.3",
		"@tsuuanmi/pi-tui": "^0.2.3",
		"typebox": "1.1.38"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "3.2.6"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsuuanmi/pi.git",
		"directory": "packages/workflows"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
