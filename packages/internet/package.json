{
	"name": "@tsuuanmi/pi-internet",
	"version": "0.1.0",
	"description": "Linux-first Pi extension that ships an isolated ChatGPT Web browser runtime and model provider.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./extension": {
			"types": "./dist/extension.d.ts",
			"import": "./dist/extension.js"
		},
		"./hooks": {
			"types": "./dist/hooks.d.ts",
			"import": "./dist/hooks.js"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#internet/*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		},
		"#internet-test/*": {
			"types": "./test/*.ts",
			"import": "./test/*.ts"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"pi": {
		"extensions": [
			"dist/extension.js"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build:daemon": "node scripts/build-daemon.mjs",
		"build": "npm run clean && tsgo -p tsconfig.build.json && npm run build:daemon",
		"test": "vitest --run"
	},
	"dependencies": {
		"@tsuuanmi/pi": "0.2.3",
		"@tsuuanmi/pi-agent": "^0.2.3",
		"@tsuuanmi/pi-tui": "^0.2.3",
		"typebox": "1.1.38"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"shx": "0.4.0",
		"tsgo": "0.0.23",
		"typescript": "5.9.3",
		"vitest": "3.2.6"
	}
}
